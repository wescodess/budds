{
  "manifestVersion": "budds.learning-decisions.v2",
  "contractVersion": "budds.learning-decision-contract.v2",
  "snapshotVersion": "quiz-answer-snapshot.v2",
  "model": {
    "provider": "laya",
    "packageVersion": "0.3.3",
    "checkpoint": "laya-typed-decisions",
    "revision": "f9ab0b228f0fc0f14d873dbc99038f135c2da1b2",
    "sha256": "4fa56de72383a9d3efa9cfa78955733c81b9fc8067a587ca4beb82c78107a24e"
  },
  "supportedLanguages": ["en", "en-*"],
  "limits": {
    "requestBytes": 32000,
    "qualityBatchSize": 20,
    "semanticBatchSize": 8,
    "requestIdChars": 128,
    "itemIdChars": 64,
    "optionCount": 8,
    "questionChars": 1200,
    "optionChars": 400,
    "evidenceChars": 1200,
    "learnerAnswerChars": 800
  },
  "retry": {
    "maxAttempts": 3,
    "baseDelayMs": 2000,
    "maxDelayMs": 60000,
    "leaseMs": 30000,
    "retryAfterMinMs": 1000,
    "retryAfterMaxMs": 60000
  },
  "timeouts": {
    "clientDeadlineMs": 12000,
    "containerDeadlineMs": 11000
  },
  "decisionKinds": {
    "quizQuality": {
      "kind": "quiz_quality",
      "primitive": "noul",
      "labels": ["supported", "needs_review"]
    },
    "freeResponse": {
      "kind": "quiz.free_response_assessment.v1",
      "primitive": "choice",
      "labels": ["fully_correct", "partially_correct", "incorrect", "uncertain"],
      "rubric": [
        {
          "label": "fully_correct",
          "description": "Evidence supports every distinct requested component; equivalent wording or order is acceptable; nothing is contradicted."
        },
        {
          "label": "partially_correct",
          "description": "Evidence supports at least one but not every requested component, or the answer adds a minor unsupported claim."
        },
        {
          "label": "incorrect",
          "description": "The answer is contradicted, unrelated, materially unsupported, or substitutes or repeats a wrong component."
        },
        {
          "label": "uncertain",
          "description": "Evidence is missing, ambiguous, or conflicting, so correctness cannot be verified."
        }
      ]
    }
  }
}
