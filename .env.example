# Advisory learning-decision pilot. Keep all values server-only.
NUXT_LEARNING_DECISION_MODE=off
NUXT_LEARNING_DECISION_PROVIDER=laya
# Alternative shadow-only free-response evaluator. Requires the existing
# Cloudflare AI Gateway and OpenRouter credentials; learner payload logging is disabled per request.
# NUXT_LEARNING_DECISION_PROVIDER=structured-llm
# NUXT_QUIZ_SEMANTIC_LLM_MODEL=openai/gpt-4o-mini
# Must match QUIZ_ASSESSMENT_WRITE_SECRET in the target Convex deployment (32+ characters).
# NUXT_QUIZ_ASSESSMENT_WRITE_SECRET=replace-with-a-server-only-secret
# Required for shadow and advisory modes; only development is eligible for synthetic evidence.
# NUXT_APPLICATION_ENVIRONMENT=development
# Advisory UI also requires this value to match a committed, approved calibration manifest.
# NUXT_QUIZ_SEMANTIC_ACTIVATION_MANIFEST=quiz-semantic-advisory.v1
# Set NUXT_LAYA_EVALUATOR_TOKEN to a server-only secret of at least 32 characters.
# NUXT_LAYA_EVALUATOR_URL=http://localhost:8788
