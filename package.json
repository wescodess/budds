{
  "name": "budds",
  "type": "module",
  "private": true,
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "build": "node scripts/validate-env.mjs build --strict && node scripts/build.mjs && node scripts/check-build-secrets.mjs",
    "deploy": "pnpm build && pnpm dlx wrangler@4.128.0 pages deploy dist --project-name budds",
    "dev": "node scripts/dev.mjs",
    "dev:stack": "node scripts/dev-stack.mjs",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "node scripts/validate-env.mjs prepare && nuxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:component": "vitest run --config vitest.config.component.ts",
    "test:component:audio": "vitest run --config vitest.config.audio-component.ts",
    "test:component:watch": "vitest --config vitest.config.component.ts",
    "test:learn-v2:unit": "vitest run convex/learnV2*.test.ts convex/accountDeletion.test.ts convex/dataExport.test.ts",
    "test:learn-v2:component": "vitest run --config vitest.config.component.ts tests/component/learn-v2",
    "test:learn-v2:calendar": "vitest run convex/learnV2Calendar.test.ts convex/learnV2CalendarReconciliation.test.ts convex/calendarConnections.test.ts convex/calendarEvents.test.ts convex/calendarEventCleanup.test.ts convex/accountDeletion.test.ts convex/dataExport.test.ts server/api/learn-v2/calendar/*.test.ts && vitest run --config vitest.config.component.ts tests/component/learn-v2/calendar-*.test.ts",
    "e2e:stack": "node scripts/e2e-stack.mjs",
    "test:e2e:learn-v2": "playwright test --config playwright.config.ts e2e/learn-v2-journey.spec.ts",
    "verify:learn-v2-beta": "pnpm typecheck && pnpm typecheck:convex && pnpm test:learn-v2:unit && pnpm test:learn-v2:component",
    "verify:learn-v2-calendar": "pnpm typecheck && pnpm typecheck:convex && pnpm test:learn-v2:calendar",
    "audio:workflow:dev": "pnpm --dir workers/audio-overview dev",
    "audio:workflow:test": "pnpm --dir workers/audio-overview test",
    "audio:workflow:typecheck": "pnpm --dir workers/audio-overview typecheck",
    "typecheck": "vue-tsc --noEmit",
    "typecheck:convex": "node scripts/validate-convex-index-names.mjs && tsc --noEmit -p convex/tsconfig.json",
    "lint": "eslint .",
    "lint:ci": "eslint . --max-warnings 0",
    "verify": "pnpm lint:ci && pnpm typecheck && pnpm typecheck:convex && pnpm test && pnpm test:component && pnpm test:component:audio && pnpm audio:workflow:typecheck && pnpm audio:workflow:test && pnpm audit && pnpm --dir workers/audio-overview audit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1029.0",
    "@convex-dev/better-auth": "^0.12.5",
    "@convex-vue/core": "0.0.4",
    "@internationalized/date": "^3.12.0",
    "@lucide/vue": "1.45.0",
    "@mozilla/readability": "^0.6.0",
    "@nuxtjs/mdc": "^0.22.1",
    "@onmax/nuxt-better-auth": "0.1.1",
    "@opentelemetry/api": "^1.9.1",
    "@tanstack/vue-table": "^8.21.3",
    "@unovis/ts": "1.7.0",
    "@unovis/vue": "^1.7.0",
    "@vueuse/core": "^14.2.1",
    "aws4fetch": "^1.0.20",
    "better-auth": "1.6.30",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "1.45.0",
    "embla-carousel-vue": "^8.6.0",
    "fflate": "^0.8.3",
    "linkedom": "^0.18.12",
    "mermaid": "^11.17.2",
    "motion-v": "^2.2.1",
    "nuxt": "^4.5.2",
    "nuxt-convex": "0.0.6",
    "reka-ui": "^2.9.5",
    "tailwind-merge": "^3.5.0",
    "vaul-vue": "^0.4.1",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.42",
    "vue-input-otp": "^0.3.2",
    "vue-router": "^5.3.1",
    "vue-sonner": "^2.0.9",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@faker-js/faker": "^10.6.0",
    "@nuxt/eslint-config": "^1",
    "@nuxt/test-utils": "^4.0.2",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.4.1",
    "@vitejs/plugin-vue": "6.0.5",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/test-utils": "^2.4.6",
    "convex-test": "^0.0.56",
    "eslint": "^10.9.1",
    "happy-dom": "^20.8.9",
    "shadcn-nuxt": "^2.5.1",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-tsc": "^3"
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server": "1.19.15",
      "brace-expansion@<3": "2.1.4",
      "brace-expansion@>=3 <6": "5.0.9",
      "deepmerge-ts": "8.0.0",
      "drizzle-orm": "0.45.2",
      "fast-xml-builder": "1.1.7",
      "fast-xml-parser": "5.7.0",
      "js-cookie": "3.0.8",
      "lodash": "4.18.0",
      "mysql2": "3.23.1",
      "nanoid@<4": "3.3.18",
      "postcss": "8.5.28",
      "valibot": "1.4.2",
      "ws": "8.21.3"
    },
    "patchedDependencies": {
      "nuxt-convex@0.0.6": "patches/nuxt-convex@0.0.6.patch"
    }
  }
}
